#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
version=1.4.2

locate_orb_setup() {
  local candidate
  for candidate in \
    "${root}/../repos/orb-setup" \
    "${root}/../repos/skastr0/orb-setup" \
    "${root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/setup.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

orb_setup="$(locate_orb_setup)" || {
  printf '[setup] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
printf '[setup] Using shared runtime at %s\n' "$orb_setup"
bash "${orb_setup}/bin/setup.sh"
export PATH="${HOME}/.local/bin:${PATH}"

if [[ "$(uname -s)" == Linux ]]; then
  missing=()
  for cmd in curl unzip python3 gh; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
  done
  if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo apt-get install -y "${missing[@]}"
  fi
fi

if ! command -v bun >/dev/null || [[ "$(bun --version)" != "$version" ]]; then
  echo "Installing Bun $version"
  curl -fsSL https://bun.com/install | bash -s "bun-v$version"
  export PATH="$HOME/.bun/bin:$PATH"
fi
# New agent shells and supervised services must see the pinned binary too.
if [[ "${AMP_ORB:-}" == 1 && "$(uname -s)" == Linux ]]; then
  binary="$(readlink -f "$(command -v bun)")"
  if [[ "$binary" != /usr/local/bin/bun ]]; then
    sudo ln -sfn "$binary" /usr/local/bin/bun
  fi
fi

echo "Installing locked dependencies"
time bun install --frozen-lockfile
echo "Building web scaffold"
time bun run build

if [[ "${AMP_ORB:-}" == 1 && "$(uname -s)" == Linux ]]; then
  # Install the Railway client only. Tailscale and Quasar come from the shared
  # runtime; authentication belongs in resume, after snapshotting.
  spec='@railway/cli@5.58.0'
  package="${spec%@*}"
  expected="${spec##*@}"
  installed="$(node -e 'try { console.log(require(process.argv[1]).version) } catch {}' "$HOME/.local/lib/node_modules/$package/package.json")"
  if [[ "$installed" != "$expected" ]]; then
    npm install --global --prefix "$HOME/.local" "$spec"
  fi
  marker='# yakjev orb clients'
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# yakjev orb clients
export PATH="$HOME/.local/bin:$PATH"
EOF
  fi
fi
echo "Orb setup complete; runtime authentication is deferred to resume"
