#!/usr/bin/env bash
set +x
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
command -v bun >/dev/null
[[ "$(bun --version)" == 1.4.2 ]] || {
  echo "Expected Bun 1.4.2; run .agents/setup" >&2
  exit 1
}

[[ "${AMP_ORB:-}" == 1 ]] || exit 0

# Forks can develop without the owner's private integrations.
# Public app. No tailnet enrollment.
if [[ -n "${YAKJEV_REMOTE_URL:-}" ]]; then
  curl --fail --silent --show-error --max-time 8 --proto '=https' "$YAKJEV_REMOTE_URL/healthz" >/dev/null \
    && echo '[resume] yakjev /healthz ok' \
    || echo '[resume] yakjev /healthz not reachable yet' >&2
fi
