#!/usr/bin/env bash
set +x
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
command -v bun >/dev/null
[[ "$(bun --version)" == 1.4.2 ]] || {
  echo "Expected Bun 1.4.2; run .agents/setup" >&2
  exit 1
}

[[ "${AMP_ORB:-}" == 1 ]] || exit 0

# Forks can develop without the owner's private integrations.
if [[ -z "${TAILSCALE_CLIENT_ID:-}" && -z "${TAILSCALE_AUDIENCE:-}" ]]; then
  echo '[resume] No Tailscale OIDC configuration; local development only'
  exit 0
fi
: "${TAILSCALE_CLIENT_ID:?Set the Tailscale OIDC client ID in Amp settings}"
: "${TAILSCALE_AUDIENCE:?Set the Tailscale OIDC audience in Amp settings}"

# Resume has a 10s window. Bound every daemon and status call.
status_timeout="${YAKJEV_RESUME_STATUS_TIMEOUT:-3}"
poll_wait="${YAKJEV_RESUME_POLL_WAIT:-4}"
online_wait="${YAKJEV_RESUME_ONLINE_WAIT:-6}"

if [[ -z "${YAKJEV_RESUME_STATUS_CMD:-}" ]]; then
  timeout "$status_timeout" sudo systemctl start tailscaled
fi

# Tailscale 1.102.4 assigns Self.Online from health.GetInPollNetMap
# (ipn/ipnlocal/local.go). BackendState=Running can persist across a failed
# poll. `tailscale whois` only reads the local netmap (client/local/local.go
# WhoIs -> LocalBackend.WhoIs); it is not a control-plane round trip.
# Ordinary `up` returns after EditPrefs, before the OIDC exchange, when the
# saved state is already Running and tags are unchanged (cli/up.go).
registration_current() {
  local status
  if [[ -n "${YAKJEV_RESUME_STATUS_CMD:-}" ]]; then
    status="$(timeout "$status_timeout" bash -c "$YAKJEV_RESUME_STATUS_CMD" 2>/dev/null || true)"
  else
    status="$(timeout "$status_timeout" sudo tailscale status --json 2>/dev/null || true)"
  fi
  [[ -n "$status" ]] || return 1
  printf '%s' "$status" | bun -e '
    const status = JSON.parse(await Bun.stdin.text());
    const health = (status.Health ?? []).join("\n");
    const self = status.Self ?? {};
    const stale =
      /node not found/i.test(health) ||
      /PollNetMap/i.test(health) ||
      status.BackendState !== "Running" ||
      self.Online !== true;
    process.exit(stale ? 1 : 0);
  '
}

wait_for_current() {
  local seconds="$1" deadline now
  deadline=$((SECONDS + seconds))
  while ((SECONDS <= deadline)); do
    if registration_current; then
      return 0
    fi
    now=$SECONDS
    ((now >= deadline)) && break
    sleep 0.5
  done
  return 1
}

connect_tailscale() {
  if [[ -n "${YAKJEV_RESUME_CONNECT_CMD:-}" ]]; then
    bash -c "$YAKJEV_RESUME_CONNECT_CMD"
    return
  fi
  # Token stays on stdin. Do not write it to disk or pass it as an argument.
  amp orb id-token --audience "$TAILSCALE_AUDIENCE" --subject-scope project |
    sudo tailscale up \
      --client-id="${TAILSCALE_CLIENT_ID}?ephemeral=true&preauthorized=true" \
      --id-token=file:/dev/stdin \
      --advertise-tags=tag:amp-orb \
      --hostname="amp-orb-$(hostname | cut -c1-40)" \
      --accept-routes=false \
      --ssh=false \
      --force-reauth \
      --timeout=20s
}

if wait_for_current "$poll_wait"; then
  echo '[resume] Tailscale registration already in the current netmap poll; skipping reauthentication'
else
  # Do not call ordinary up first. On 1.102.4 it can EditPrefs and return
  # before exchanging the token while the saved state still says Running.
  echo '[resume] Tailscale registration not in the current netmap poll; forcing a fresh OIDC exchange'
  if ! connect_tailscale; then
    echo '[resume] OIDC exchange failed' >&2
    exit 1
  fi
  if ! wait_for_current "$online_wait"; then
    echo '[resume] Tailscale registration still not in the current netmap poll after reauthentication' >&2
    exit 1
  fi
fi

probe_failed=0
probe_ran=0
for entry in "${QUASAR_SERVER_URL:-}|/health" "${YAKJEV_REMOTE_URL:-}|/healthz"; do
  base="${entry%|*}"
  path="${entry##*|}"
  [[ -n "$base" ]] || continue
  probe_ran=1
  if [[ "$base" != https://* ]]; then
    echo "[resume] $path requires an https origin" >&2
    probe_failed=1
    continue
  fi
  echo "[resume] Checking configured HTTPS service ($path)"
  # Independent probes: one outage must not hide the other result.
  # A failed probe is not evidence of a missing grant or a removed node.
  if ! curl --fail --silent --show-error --proto '=https' \
    --connect-timeout 5 --max-time 15 --retry 1 --retry-delay 1 \
    --retry-max-time 20 --retry-connrefused "${base%/}$path" >/dev/null; then
    echo "[resume] HTTPS probe failed ($path); not diagnosing grant or node removal" >&2
    probe_failed=1
  else
    echo "[resume] HTTPS probe passed ($path)"
  fi
done
if [[ "$probe_ran" -eq 0 ]]; then
  echo '[resume] No remote HTTPS services configured; liveness is not end-to-end proof'
elif [[ "$probe_failed" -ne 0 ]]; then
  echo '[resume] One or more configured HTTPS probes failed' >&2
  exit 1
fi

# Railway reads RAILWAY_API_TOKEN (account) or RAILWAY_TOKEN (project) directly.
# Do not log in, link an unrelated project, or deploy during lifecycle hooks.
if [[ -n "${RAILWAY_API_TOKEN:-}${RAILWAY_TOKEN:-}" ]]; then
  echo '[resume] Railway credential available to CLI; no deployment performed'
else
  echo '[resume] Railway credential absent; deployment access not configured'
fi
