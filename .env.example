# Local graph API. Never commit a real owner token or provider key.
# YAKJEV_DATA_DIR=.data
# YAKJEV_LISTEN_PORT=3210

# Synthetic loopback auth for local development only. The server rejects this
# outside a non-production loopback origin. Never set it in production.
# YAKJEV_DEV_AUTH=true

# Production and any non-loopback origin require an owner token of at least 32 characters.
# YAKJEV_OWNER_TOKEN=
# YAKJEV_OWNER_ID=owner
# Public origin. Railway sets RAILWAY_PUBLIC_DOMAIN; the entrypoint turns that into https://<domain>.
# YAKJEV_ORIGIN=https://yakjev.up.railway.app
# Server-side Jev calls. Absent key records unavailable judgments; never use a VITE_ prefix.
# TYPESAFE_API_KEY=
# Semantic retrieval (Synthetic nomic embeddings). Absent: ranking stays lexical.
# SYNTHETIC_API_KEY=
