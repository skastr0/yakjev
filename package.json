{
  "name": "yakjev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun packages/server/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages",
    "test:deploy": "bash deploy/tests/run.sh && bash deploy/tests/resume.sh",
    "test:acceptance": "bun test tests/acceptance",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "verify": "bun run check:format && bun run typecheck && bun run test && bun run test:acceptance && bun run build && bun run test:deploy"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
